# --- Clinic Identity & Settings ---
CLINIC_NAME=Apex Dental Care
AGENT_NAME=Sarah
TIMEZONE=Australia/Sydney
API_ALLOWED_ORIGINS=*

# --- HubSpot CRM Integration ---
HUBSPOT_ACCESS_TOKEN=pat-na2-your-token-here

# --- Vapi Integration ---
VAPI_PRIVATE_KEY=your-vapi-private-key
VAPI_PUBLIC_KEY=your-vapi-public-key
VAPI_ASSISTANT_ID=your-vapi-assistant-id

# --- Admin Fallback Credentials ---
# Use a bcrypt hash for the password. You can generate one using a tool or a script.
ADMIN_FALLBACK_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2b$12$your-bcrypt-hash

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL=https://your-app.fly.dev
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
